# ORBITALIS web configuration.
#
# Leave VITE_API_URL unset to serve the checked-in demo bundle from
# public/mock/bundle.json. No backend is needed, and the app shows a
# "Mock API" banner.
#
# Set it to the FULL API root, including /api/v1. Do not include a trailing slash.
#   VITE_API_URL=http://localhost:8080/api/v1
#   VITE_API_URL=/api/v1                       # through the Vite dev proxy
#   VITE_API_URL=https://orbitalis-api-894548039245.me-central1.run.app/api/v1
#
# VITE_API_URL=http://localhost:8080/api/v1
